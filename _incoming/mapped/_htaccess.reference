# .htaccess — League of Pokemons
# PHP 8.x / Apache 2.4+

# ── PHP-настройки ──────────────────────────────────────────────────────────────
# Убраны устаревшие cp1251 — используем UTF-8 везде
php_value default_charset UTF-8
php_value error_log PHP_errors.log
php_flag  log_errors on
php_flag  display_errors off
php_value error_reporting -1
php_value log_errors_max_len 0

# ── Обработка PHP ──────────────────────────────────────────────────────────────
# AddHandler нужен только если сервер не настроен автоматически:
# AddHandler application/x-httpd-php8 .php

# ── Защита логов ───────────────────────────────────────────────────────────────
<Files "PHP_errors.log">
    Require all denied
</Files>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# ── Перезапись URL ─────────────────────────────────────────────────────────────
RewriteEngine On

# Стили через PHP (если нужно)
RewriteRule ^css/([a-zA-Z0-9_]+)\.css$ style.php?file=$1 [L,QSA]

# Блокировка robots.txt
RewriteRule ^robots\.txt$ - [F,L]

# ── Кодировка ответов ──────────────────────────────────────────────────────────
AddDefaultCharset UTF-8

# ── Безопасность ───────────────────────────────────────────────────────────────
# Запрет прямого доступа к системным файлам
<FilesMatch "\.(log|txt|md|sh|env)$">
    Require all denied
</FilesMatch>
