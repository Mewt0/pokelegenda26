Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^css/([a-zA-Z0-9_]+)\.css$ style.php?file=$1 [L]
    RewriteRule ^robots\.txt$ - [F,L]
</IfModule>

<FilesMatch "^(\.env|.*\.sql|.*\.log|PHP_errors\.log|log_php_errors\.txt)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>