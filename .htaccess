Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Internal source, backups and local QA helpers are never web endpoints.
    RewriteRule ^(?:\.git|\.hybrid|\.codebase-memory|_incoming|config|database|docs|src|storage|tools|vendor)(?:/|$) - [F,L,NC]
    # Legacy admin is not a web endpoint. The working admin is /game/admin.
    RewriteRule ^admin(?:/|$) - [F,L,NC]
    RewriteRule ^include(?:/|$) - [F,L,NC]
    RewriteRule ^_qa-(?:view|viewport)\.php$ - [F,L,NC]
    RewriteRule ^include/function/Services_JSON\.php$ - [F,L,NC]
    RewriteRule ^(?:debug_[^/]*|Rewire_mysql\.json|RELEASE_MANIFEST\.json|DEPLOY\.txt|probe\.js|shot\.js)$ - [F,L,NC]
    RewriteRule ^css/([a-zA-Z0-9_]+)\.css$ style.php?file=$1 [L]
    RewriteRule ^(login|logout|register)$ public/index.php [QSA,L]
    RewriteRule ^password/(forgot|reset)$ public/index.php [QSA,L]
    RewriteRule ^email/verify$ public/index.php [QSA,L]
    RewriteRule ^profile(/email)?$ public/index.php [QSA,L]
    RewriteRule ^(game|api)(/.*)?$ public/index.php [QSA,L]
    RewriteRule ^robots\.txt$ - [F,L]
</IfModule>

<FilesMatch "(?i)^(\.env(?:\..*)?|.*\.(?:sql|log|zip|rar|7z|tar|gz|bak|md|xlsx|py|ps1)|PHP_errors\.log|log_php_errors\.txt)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
